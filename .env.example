# =============================================================
# AutoRetoma — variáveis de ambiente
# Copiar para .env.local e preencher com os valores do projeto
# Supabase (Dashboard > Project Settings > API).
# =============================================================

# URL público do projeto Supabase (com `supabase start` local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave anónima (pública) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — APENAS no servidor. Nunca expor no frontend
# nem colocar em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# URL canónico do site (produção: https://autoretoma.pt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal usado para gerar o hash do IP nos pedidos de contacto
# (anti-spam). Gerar um valor aleatório longo, p. ex.: openssl rand -hex 32
LEAD_IP_SALT=muda-este-valor-para-um-segredo-aleatorio

# ID do formulário Formspree usado na página de contactos (ex.: xrbqzabc).
# Obtém-se em formspree.io > New Form. Opcional: sem ele, a página mostra
# apenas o endereço de email.
NEXT_PUBLIC_FORMSPREE_ID=
